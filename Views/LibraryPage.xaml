<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PAGELY.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PAGELY.Models"
    xmlns:vm="clr-namespace:PAGELY.ViewModels"
    x:Name="Library"
    x:DataType="vm:LibraryViewModel"
    Title="Library"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource Paper}">

    <Grid RowDefinitions="Auto,Auto,*">

        <VerticalStackLayout Grid.Row="0">
            <!-- Brand bar -->
            <Grid BackgroundColor="{DynamicResource Paper}" ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="20,12,20,12">
                <Image
                    Aspect="AspectFit"
                    HeightRequest="44"
                    Source="pagely_logo.png"
                    VerticalOptions="Center"
                    WidthRequest="44" />
                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                    <Label
                        CharacterSpacing="3"
                        FontSize="20"
                        Style="{StaticResource CardTitle}"
                        Text="PAGELY" />
                    <Label Style="{StaticResource Caption}" Text="Your personal reading space" />
                </VerticalStackLayout>
            </Grid>
            <BoxView BackgroundColor="{DynamicResource Divider}" HeightRequest="1" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="20,20,20,8" Spacing="6">
            <Label Style="{StaticResource Eyebrow}" Text="YOUR COLLECTION" />
            <Label Style="{StaticResource PageTitle}" Text="My Library" />
            <BoxView Style="{StaticResource TitleRule}" />
            <Label Style="{StaticResource PageSubtitle}" Text="{Binding Books.Count, StringFormat='{0} books'}" />
            <Button
                Command="{Binding ImportCommand}"
                HorizontalOptions="Start"
                Margin="0,10,0,0"
                Padding="24,0"
                Style="{StaticResource ButtonPrimary}"
                Text="+ Import Books" />
        </VerticalStackLayout>

        <Grid Grid.Row="2">
            <CollectionView
                IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView HeightRequest="12" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView HeightRequest="88" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Book">
                        <VerticalStackLayout Spacing="4" Padding="2,0">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenCommand, Source={x:Reference Library}}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <!-- Cover -->
                            <Border
                                BackgroundColor="{DynamicResource Spine}"
                                HeightRequest="180"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                WidthRequest="120"
                                HorizontalOptions="Center">
                                <Grid>
                                    <Image
                                        Aspect="AspectFill"
                                        IsVisible="{Binding CoverPath, Converter={StaticResource HasValue}}"
                                        Source="{Binding CoverPath}" />
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="28"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding CoverPath, Converter={StaticResource InverseHasValue}}"
                                        Text="{Binding Initial}"
                                        TextColor="{DynamicResource Surface}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <!-- Title -->
                            <Label
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                LineHeight="1.2"
                                MaxLines="2"
                                MaximumWidthRequest="120"
                                Style="{StaticResource CardTitle}"
                                Text="{Binding Title}" />

                            <!-- Author -->
                            <Label
                                FontSize="11"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                MaximumWidthRequest="120"
                                Style="{StaticResource CardMeta}"
                                Text="{Binding Author}" />

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="20,8,20,0" VerticalOptions="Start">
                <Border Style="{StaticResource DashedCard}" StrokeDashArray="4,4">
                    <VerticalStackLayout Spacing="12">
                        <Border Style="{StaticResource IconTile}">
                            <Image
                                Aspect="AspectFit"
                                HeightRequest="28"
                                HorizontalOptions="Center"
                                Source="tab_library.svg"
                                VerticalOptions="Center"
                                WidthRequest="28" />
                        </Border>
                        <Label
                            FontSize="22"
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource CardTitle}"
                            Text="Your library is empty" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource PageSubtitle}"
                            Text="Import EPUB, PDF or TXT files already on this device." />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />

        </Grid>
    </Grid>
</ContentPage>
