<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Cream paper and deep cocoa, sampled from the Pagely web redesign.
         Every original key is kept, so no page needs to change.
         Paper is the app background, Card the raised surface, Ink the cocoa text,
         Secondary the soft tint behind pills and icon tiles, Accent the gold rule. -->
    <Color x:Key="Primary">#4A2411</Color>
    <Color x:Key="PrimaryDark">#331708</Color>
    <Color x:Key="PrimaryLight">#8B5A3C</Color>
    <Color x:Key="Secondary">#F3E6D9</Color>
    <Color x:Key="SecondaryAlt">#EAD8C9</Color>
    <Color x:Key="Surface">#FFFDF8</Color>
    <Color x:Key="SurfaceAlt">#F3E6D9</Color>
    <Color x:Key="Paper">#FFF8EC</Color>
    <Color x:Key="Card">#FFFDF8</Color>
    <Color x:Key="PageBackdrop">#EADFD1</Color>
    <Color x:Key="Ink">#4A2411</Color>
    <Color x:Key="InkSoft">#5A3F2E</Color>
    <Color x:Key="Muted">#7D6757</Color>
    <Color x:Key="Divider">#EADFD1</Color>
    <Color x:Key="Shadow">#4A2411</Color>
    <Color x:Key="Spine">#6B3A1F</Color>
    <Color x:Key="Accent">#C79A5B</Color>
    <Color x:Key="Success">#6C8A6E</Color>
    <Color x:Key="Danger">#B3382C</Color>
    <Color x:Key="StatusTbr">#7C93A3</Color>
    <Color x:Key="StatusReading">#C79A5B</Color>
    <Color x:Key="StatusCompleted">#6C8A6E</Color>
    <Color x:Key="StatusDropped">#A5766A</Color>
    <Color x:Key="Highlight">#E9D7A4</Color>
    <Color x:Key="HighlightSoft">#F2E7C9</Color>
    <Color x:Key="WarmAccent">#C79A5B</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1B1815</Color>
    <!-- Neutral ramp, warmed so it never fights the paper background. -->
    <Color x:Key="Gray100">#F8EFE4</Color>
    <Color x:Key="Gray200">#EADFD1</Color>
    <Color x:Key="Gray300">#D9C7B0</Color>
    <Color x:Key="Gray400">#A89484</Color>
    <Color x:Key="Gray500">#7D6757</Color>
    <Color x:Key="Gray600">#5A3F2E</Color>
    <Color x:Key="Gray900">#4A2411</Color>
    <Color x:Key="Gray950">#331708</Color>
    <Color x:Key="EyebrowColor">#8B5A3C</Color>
    <Color x:Key="DashedStroke">#D9C7B0</Color>
    <!-- Titles use a display serif (Georgia on Windows/iOS, the built-in serif on Android);
         see PageTitle / CardTitle / StatValue in Styles.xaml. To switch to DM Serif Display, add the .ttf
         to Resources/Fonts, register it in MauiProgram.cs and replace the three OnPlatform blocks. -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAlt}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource Card}"/>
    <SolidColorBrush x:Key="PageBackdropBrush" Color="{StaticResource PageBackdrop}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoft}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource Shadow}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource Highlight}"/>
    <SolidColorBrush x:Key="HighlightSoftBrush" Color="{StaticResource HighlightSoft}"/>
    <SolidColorBrush x:Key="WarmAccentBrush" Color="{StaticResource WarmAccent}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="StatusTbrBrush" Color="{StaticResource StatusTbr}"/>
    <SolidColorBrush x:Key="StatusReadingBrush" Color="{StaticResource StatusReading}"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{StaticResource StatusCompleted}"/>
    <SolidColorBrush x:Key="StatusDroppedBrush" Color="{StaticResource StatusDropped}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
</ResourceDictionary>
